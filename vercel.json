{
  "version": 2,
  "buildCommand": null,
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/health.js": { "maxDuration": 10 },
    "api/status.js": { "maxDuration": 15 }
  },
  "rewrites": [
    { "source": "/api/health", "destination": "/api/health.js" },
    { "source": "/api/status", "destination": "/api/status.js" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
